# https://takeuforward.org/plus/dsa/problems/pattern-3
class Solution:
    def pattern3(self, n):
        for i in range(1,n+1):
            for j in range(1,i+1):
                print(j, end="")
            print()

# Method 2 
class Solution:
    def pattern3(self, n):
        for i in range(0,n):
            for j in range(0,i+1):
                print(j+1, end="")
            print(end="\n")
