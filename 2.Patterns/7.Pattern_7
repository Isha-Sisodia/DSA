# https://takeuforward.org/plus/dsa/problems/pattern-7

# Method 1 

n = 5
for i in range(1,n+1):
    print(" "*(n-i) + "*"*(2*i-1))

# Method 2

n = 5
odd_mul = 1
spacer = n - 1
for i in range(n):
    print(" " * spacer + "*" * odd_mul)
    odd_mul += 2
    spacer -= 1


# Printing odd numbers

n = 5
for i in range(1,n+1):
    print(2 * i - 1)
    
#or

n = 5
for i in range(n):
    print(2 * i + 1)
